# 复制成 .env 即可生效（.env 已在 .gitignore 里，不会被提交）
#     cp .env.example .env
#
# 全部为可选。**什么都不配也能完整跑通** —— 见 RUN.md「5 分钟跑通」。

# ---------- 数据模式 ----------
# fixture（默认）: 只读 data/ 下的本地样本，零联网，结果完全可复现
# live            : 只走真实外网源
# hybrid          : 先试真实源，失败自动回落 fixture 并在 data_origin 里标注
MINING_DAILY_MODE=fixture

# ---------- LLM（Agent 的规划与叙述）----------
# deepseek（默认） / openai / offline
# 设成 offline 就强制走本地规划 + 模板草稿，用于**验证"没 key 也能出简报"**
MINING_DAILY_LLM_PROVIDER=deepseek

# DeepSeek（推荐）。不填则自动回落到模板草稿，简报照样出，只是行文更机械。
MINING_DAILY_DEEPSEEK_API_KEY=
MINING_DAILY_DEEPSEEK_MODEL=deepseek-chat

# 想换成 OpenAI 兼容端点时使用
# MINING_DAILY_LLM_PROVIDER=openai
# MINING_DAILY_OPENAI_API_KEY=
# MINING_DAILY_OPENAI_BASE_URL=https://api.openai.com/v1
# MINING_DAILY_OPENAI_MODEL=gpt-4o-mini

# ---------- 日志 ----------
# DEBUG / INFO / WARNING（默认）/ CRITICAL
# 日志一律走 stderr —— stdout 是 MCP 的 JSON-RPC 通道，被污染就没法通信了
MINING_DAILY_LOG_LEVEL=WARNING

# ---------- 网络（live/hybrid 模式才用得到）----------
# MINING_DAILY_REQUEST_TIMEOUT=20
# MINING_DAILY_MAX_RETRIES=3
